{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InvokeScoutMatchAgentAliasOnly",
      "Effect": "Allow",
      "Action": ["bedrock:InvokeAgent"],
      "Resource": ["{{AGENT_ALIAS_ARN}}"]
    },
    {
      "Sid": "ListPrivateLineupSvgPrefixOnly",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": ["arn:aws:s3:::{{BUCKET_NAME}}"],
      "Condition": {
        "StringLike": {
          "s3:prefix": ["scoutmatch/football-operations/lineups/*"]
        }
      }
    },
    {
      "Sid": "ReadPrivateLineupSvgObjectsOnly",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": ["arn:aws:s3:::{{BUCKET_NAME}}/scoutmatch/football-operations/lineups/*"]
    },
    {
      "Sid": "ReadLineupBoardMetadataOnly",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem"],
      "Resource": ["arn:aws:dynamodb:{{REGION}}:{{ACCOUNT_ID}}:table/{{FOOTBALL_OPS_TABLE}}"]
    }
  ]
}
