# Copy this file to .env locally and fill in real values only on your machine.
# Never commit .env — it stays out of Docker via .dockerignore.

# --- Production: AWS Knowledge Base (ScoutMatch) ---
RAG_BACKEND=aws_kb

AWS_REGION=us-east-1

BEDROCK_KB_ID=
BEDROCK_DATA_SOURCE_ID=
BEDROCK_MODEL_ARN=arn:aws:bedrock:us-east-1::foundation-model/amazon.nova-lite-v1:0
AWS_KB_TOP_K=5
AWS_KB_RETRIEVE_CANDIDATES=30
AWS_KB_CONTEXT_SOURCE_LIMIT=10
AWS_KB_MAX_CHUNKS_PER_SOURCE=2
AWS_KB_CONTEXT_EXCERPT_MAX=1200
AWS_KB_MIN_SCORE=

AWS_S3_BUCKET=
AWS_S3_PREFIX=scoutmatch/knowledge-base/

# --- Baseline club knowledge (optional; production EC2 uses true) ---
# When enabled, read-only club documents under baseline/<AWS_BASELINE_SET_ID>/ are
# available in every conversation alongside session-scoped candidate uploads.
# BASELINE_KNOWLEDGE_ENABLED=false
# AWS_BASELINE_SET_ID=production

FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false

MAX_UPLOAD_MB=25

# --- Local development fallback (RAG_BACKEND=local) ---
# GEMINI_API_KEY=
# HF_TOKEN=
# GEMINI_MODEL=gemini-2.5-flash

# Optional: enable image uploads in local mode only
# ENABLE_IMAGE_UPLOADS=false

# --- Business workflow v2 (feature-flagged rollout) ---
# SCOUTMATCH_BUSINESS_WORKFLOW_V2_ENABLED=false
# SCOUTMATCH_EMAIL_MODE=disabled
# SCOUTMATCH_CALENDAR_MODE=ics_fallback
# SCOUTMATCH_SCOUTING_REMINDER_MODE=disabled
# SCOUTMATCH_DEMO_REPLAY_ENABLED=true
# SCOUTMATCH_SES_SENDER=
# SCOUTMATCH_SES_REVIEW_RECIPIENT=
# SCOUTMATCH_GOOGLE_CALENDAR_ACCESS_TOKEN=
# SCOUTMATCH_GOOGLE_CALENDAR_ID=
