# Optional ScoutMatch Bedrock Agent + Flow extension (local only — never commit .env.agent)
SCOUTMATCH_AGENT_EXTENSION_ENABLED=false
SCOUTMATCH_FLOW_EXTENSION_ENABLED=false
AWS_REGION=us-east-1
SCOUTMATCH_AGENT_ID=
SCOUTMATCH_AGENT_ALIAS_ID=
SCOUTMATCH_FLOW_ID=
SCOUTMATCH_FLOW_ALIAS_ID=
