# SCOUTMATCH_SHORTLIST_TABLE=ScoutMatchRecruitmentShortlistAvidan
# SCOUTMATCH_REVIEWS_TABLE=ScoutMatchRecruitmentReviewsAvidan
# SCOUTMATCH_BRIEF_PREFIX=scoutmatch/recruitment-advisor/briefs/
